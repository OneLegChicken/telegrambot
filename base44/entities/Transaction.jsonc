    },
    "type": {
      "type": "string",
      "enum": [
        "topup",
        "purchase",
        "refund",
        "adjust",
        "notification"
      ],
      "description": "\u0646\u0648\u0639 \u062a\u0631\u0627\u06a9\u0646\u0634"
    },
    "amount": {
      "type": "number",
      "description": "\u0645\u0628\u0644\u063a (\u062a\u0648\u0645\u0627\u0646)"
    },
    "note": {
      "type": "string",
      "description": "\u062a\u0648\u0636\u06cc\u062d"
    },
    "notified": {
